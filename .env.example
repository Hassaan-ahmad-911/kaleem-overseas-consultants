# Copy to .env and fill in real values. Never commit .env.

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# True only on your own computer. Must be False on the live server.
DEBUG=False

# Domains / IP the site is served on, comma-separated (no spaces, no https://).
ALLOWED_HOSTS=localhost,127.0.0.1

# Needed on the live HTTPS site for forms to submit: full origins, comma-separated.
# Example: https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=

DB_NAME=kaleem_overseas_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
